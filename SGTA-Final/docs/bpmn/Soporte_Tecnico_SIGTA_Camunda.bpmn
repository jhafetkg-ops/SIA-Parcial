    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_RecibirInformeJefeCarrera" targetRef="Gateway_ParaleloJoin" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gateway_ParaleloJoin" targetRef="End_Fin" />
  </bpmn:process>
