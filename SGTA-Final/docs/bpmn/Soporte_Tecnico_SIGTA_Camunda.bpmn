    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_InformarConformidad" targetRef="Task_InformeFinal" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_InformeFinal" targetRef="Gateway_ParaleloSplit" />
