    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_NotificarRechazo" targetRef="End_TicketNoProcede" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ClasificarSLA" targetRef="Task_DesignarRevision" />
