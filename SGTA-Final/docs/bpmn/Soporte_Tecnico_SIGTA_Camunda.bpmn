    <bpmn:sequenceFlow id="Flow_11_No" sourceRef="Gateway_RequiereCompra" targetRef="Gateway_MergeReparacion" name="no" />
    <bpmn:sequenceFlow id="Flow_12_Si" sourceRef="Gateway_RequiereCompra" targetRef="Task_RealizarRequerimiento" name="sí" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RealizarRequerimiento" targetRef="Task_RecibirRequerimiento" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RecibirRequerimiento" targetRef="Gateway_ViableCompra" />
    <bpmn:sequenceFlow id="Flow_15_No" sourceRef="Gateway_ViableCompra" targetRef="Task_ComunicarNoViabilidad" name="no" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ComunicarNoViabilidad" targetRef="End_CerradoSinCompra" />
    <bpmn:sequenceFlow id="Flow_17_Si" sourceRef="Gateway_ViableCompra" targetRef="Task_ElevarInforme" name="sí" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ElevarInforme" targetRef="Task_AutorizarCompra" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AutorizarCompra" targetRef="SubProcess_GestionCompra" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="SubProcess_GestionCompra" targetRef="Task_ActualizarInventario" />
