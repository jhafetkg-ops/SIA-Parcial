<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_SoporteTecnico" targetNamespace="http://sigta.emi.bo/bpmn/soporte-tecnico" exporter="OpenAI" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7">
  <bpmn:process id="Process_SoporteTecnico" name="DIAGRAMA 1 - SOPORTE TÉCNICO" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Soporte">
      <bpmn:lane id="Lane_Usuario" name="USUARIO SOLICITANTE">
        <bpmn:flowNodeRef>Start_Ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarFuncionamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProblemaResuelto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformarConformidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_JefeUTIC" name="JEFE DE UTIC">
        <bpmn:flowNodeRef>Task_RecibirValidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TicketValido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClasificarSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TicketNoProcede</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignarRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirRequerimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ViableCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComunicarNoViabilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CerradoSinCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElevarInforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformeFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParaleloSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParaleloJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Especialistas" name="ESPECIALISTAS">
        <bpmn:flowNodeRef>Task_RecibirOrden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspeccionDiagnostico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RequiereCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RealizarRequerimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeReparacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepararInstalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PruebasTecnicas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarInformeUTIC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direccion" name="DIRECTOR/JEFE DE SECCIÓN">
        <bpmn:flowNodeRef>Task_AutorizarCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirInformeDirector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirInformeJefeCarrera</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finanzas" name="ASUNTOS FINANCIEROS">
        <bpmn:flowNodeRef>SubProcess_GestionCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualizarInventario</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Ticket" name="Ticket requerido" />
    <bpmn:manualTask id="Task_RegistrarTicket" name="Registrar ticket" />
    <bpmn:userTask id="Task_RecibirValidar" name="Recibir Ticket y validar Ticket" />
    <bpmn:exclusiveGateway id="Gateway_TicketValido" name="Ticket válido?" />
    <bpmn:userTask id="Task_ClasificarSLA" name="Clasificar prioridad y asignar SLA" />
    <bpmn:userTask id="Task_NotificarRechazo" name="Notificar rechazo al usuario solicitante" />
    <bpmn:endEvent id="End_TicketNoProcede" name="Ticket no procede" />
    <bpmn:userTask id="Task_DesignarRevision" name="Designar revisión al equipo de especialistas" />
    <bpmn:userTask id="Task_RecibirOrden" name="Recibir orden de trabajo" />
    <bpmn:userTask id="Task_InspeccionDiagnostico" name="Realizar inspección técnica y diagnóstico" />
    <bpmn:exclusiveGateway id="Gateway_RequiereCompra" name="Requiere compra?" />
    <bpmn:userTask id="Task_RealizarRequerimiento" name="Realizar requerimiento" />
    <bpmn:userTask id="Task_RecibirRequerimiento" name="Recibir requerimiento y cotización" />
    <bpmn:exclusiveGateway id="Gateway_ViableCompra" name="Es viable la compra?" />
    <bpmn:userTask id="Task_ComunicarNoViabilidad" name="Comunicar no viabilidad" />
    <bpmn:endEvent id="End_CerradoSinCompra" name="Cerrado sin compra" />
    <bpmn:userTask id="Task_ElevarInforme" name="Elevar el informe" />
    <bpmn:userTask id="Task_AutorizarCompra" name="Autorizar y continuar flujo de solicitud de compra" />
    <bpmn:subProcess id="SubProcess_GestionCompra" name="Gestión de compra de Activos Fijos" />
    <bpmn:businessRuleTask id="Task_ActualizarInventario" name="Actualizar inventario y garantía" />
    <bpmn:exclusiveGateway id="Gateway_MergeReparacion" />
    <bpmn:serviceTask id="Task_RepararInstalar" name="Realizar la reparación/instalación del equipo y registrar" />
    <bpmn:serviceTask id="Task_PruebasTecnicas" name="Realizar pruebas técnicas" />
    <bpmn:userTask id="Task_RegistrarInformeUTIC" name="Registrar informe al jefe UTIC" />
    <bpmn:userTask id="Task_VerificarFuncionamiento" name="Verificar funcionamiento" />
    <bpmn:exclusiveGateway id="Gateway_ProblemaResuelto" name="Problema Resuelto?" />
    <bpmn:userTask id="Task_InformarConformidad" name="Informar conformidad" />
    <bpmn:userTask id="Task_InformeFinal" name="Elaborar y validar informe final" />
    <bpmn:parallelGateway id="Gateway_ParaleloSplit" />
    <bpmn:userTask id="Task_RecibirInformeDirector" name="Recibir informe de actividades (Director)" />
    <bpmn:userTask id="Task_RecibirInformeJefeCarrera" name="Recibir informe de actividades (Jefe de carrera)" />
    <bpmn:parallelGateway id="Gateway_ParaleloJoin" />
    <bpmn:endEvent id="End_Fin" name="Fin" />
    <bpmn:textAnnotation id="Annotation_TicketDatos">
      <bpmn:text>(descripción, ubicación, equipo, evidencias)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Componente">
      <bpmn:text>características del componente y cotización</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TicketDatos" sourceRef="Task_RegistrarTicket" targetRef="Annotation_TicketDatos" />
    <bpmn:association id="Association_Componente" sourceRef="Task_RealizarRequerimiento" targetRef="Annotation_Componente" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Ticket" targetRef="Task_RegistrarTicket" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RegistrarTicket" targetRef="Task_RecibirValidar" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_RecibirValidar" targetRef="Gateway_TicketValido" />
    <bpmn:sequenceFlow id="Flow_04_Si" sourceRef="Gateway_TicketValido" targetRef="Task_ClasificarSLA" name="sí" />
