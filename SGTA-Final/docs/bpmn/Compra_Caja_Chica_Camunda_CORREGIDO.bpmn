<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CompraCajaChica" targetNamespace="http://sigta.emi.bo/bpmn/compra-caja-chica" exporter="Camunda Modeler" exporterVersion="5.x" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7">
  <bpmn:process id="Process_CompraCajaChica" name="DIAGRAMA DE BPMN DE COMPRA DE CAJA CHICA" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CompraCajaChica">
      <bpmn:lane id="Lane_UnidadSolicitante" name="Unidad Solicitante">
        <bpmn:flowNodeRef>Start_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarExpediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntregaDescargo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OAF" name="OAF">
        <bpmn:flowNodeRef>Task_EvaluarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CalificaSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoCalifica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerarCertificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarExpedienteCompleto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tesoreria" name="Tesorería">
        <bpmn:flowNodeRef>Task_VerificarExpediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesembolsarDinero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirDocumentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarArchivar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="Director">
        <bpmn:flowNodeRef>Task_VistoBueno</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComprasAlmacen" name="Encargado de Compras y Almacén">
        <bpmn:flowNodeRef>Task_CompraPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarAlmacen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Inicio" name="INICIO"/>
    <bpmn:task id="Task_EnviarExpediente" name="ENVIAR EXPEDIENTE"/>
    <bpmn:task id="Task_EvaluarSolicitud" name="EVALUAR SOLICITUD Y VERIFICAR PRESUPUESTO"/>
    <bpmn:exclusiveGateway id="Gateway_CalificaSolicitud" name="¿CALIFICA LA SOLICITUD?"/>
    <bpmn:endEvent id="End_NoCalifica" name="END"/>
    <bpmn:task id="Task_GenerarCertificacion" name="GENERAR Y ADJUNTAR CERTIFICACIÓN PRESUPUESTARIA"/>
    <bpmn:task id="Task_EnviarExpedienteCompleto" name="ENVIAR EXPEDIENTE COMPLETO"/>
    <bpmn:task id="Task_VerificarExpediente" name="VERIFICA TODO EL EXPEDIENTE"/>
    <bpmn:task id="Task_DesembolsarDinero" name="DESEMBOLSA DINERO"/>
    <bpmn:task id="Task_VistoBueno" name="LE DA EL VISTO BUENO Y DERIVA A TESORERÍA"/>
    <bpmn:task id="Task_CompraPedido" name="COMPRA EL PEDIDO"/>
    <bpmn:task id="Task_RegistrarAlmacen" name="REGISTRA ENTRADA Y SALIDA DE ALMACÉN"/>
    <bpmn:task id="Task_RecibirPedido" name="RECIBE EL PEDIDO CON UN ACTA DE CONFORMIDAD"/>
    <bpmn:task id="Task_EntregaDescargo" name="ENTREGA DE DOCUMENTOS DE DESCARGO"/>
    <bpmn:task id="Task_RecibirDocumentos" name="RECIBE TODOS LOS DOCUMENTOS"/>
    <bpmn:task id="Task_VerificarArchivar" name="VERIFICA Y ARCHIVA LOS DOCUMENTOS"/>
    <bpmn:endEvent id="End_Fin" name="FIN"/>
    <bpmn:dataObject id="DataObject_Expediente"/>
    <bpmn:dataObjectReference id="DataRef_Expediente" name="INFORME&#10;-POA&#10;-PEDIDO&#10;PROFORMA" dataObjectRef="DataObject_Expediente"/>
    <bpmn:dataObject id="DataObject_Descargo"/>
    <bpmn:dataObjectReference id="DataRef_Descargo" name="-FACTURA&#10;-ACTA DE CONFORMIDAD&#10;-FOTOGRAMA" dataObjectRef="DataObject_Descargo"/>
    <bpmn:association id="Association_Expediente" sourceRef="Task_EnviarExpediente" targetRef="DataRef_Expediente"/>
    <bpmn:association id="Association_Descargo" sourceRef="Task_EntregaDescargo" targetRef="DataRef_Descargo"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Inicio" targetRef="Task_EnviarExpediente"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_EnviarExpediente" targetRef="Task_EvaluarSolicitud"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_EvaluarSolicitud" targetRef="Gateway_CalificaSolicitud"/>
    <bpmn:sequenceFlow id="Flow_04_NO" sourceRef="Gateway_CalificaSolicitud" targetRef="End_NoCalifica" name="NO"/>
    <bpmn:sequenceFlow id="Flow_05_SI" sourceRef="Gateway_CalificaSolicitud" targetRef="Task_GenerarCertificacion" name="SI"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_GenerarCertificacion" targetRef="Task_EnviarExpedienteCompleto"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_EnviarExpedienteCompleto" targetRef="Task_VerificarExpediente"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_VerificarExpediente" targetRef="Task_VistoBueno"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_VistoBueno" targetRef="Task_DesembolsarDinero"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DesembolsarDinero" targetRef="Task_CompraPedido"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CompraPedido" targetRef="Task_RegistrarAlmacen"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RegistrarAlmacen" targetRef="Task_RecibirPedido"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RecibirPedido" targetRef="Task_EntregaDescargo"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_EntregaDescargo" targetRef="Task_RecibirDocumentos"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RecibirDocumentos" targetRef="Task_VerificarArchivar"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_VerificarArchivar" targetRef="End_Fin"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_CompraCajaChica">
    <bpmn:participant id="Participant_CompraCajaChica" name="DIAGRAMA DE BPMN DE COMPRA DE CAJA CHICA" processRef="Process_CompraCajaChica"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CompraCajaChica">
    <bpmndi:BPMNPlane id="BPMNPlane_CompraCajaChica" bpmnElement="Collaboration_CompraCajaChica">
      <bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Participant_CompraCajaChica" isHorizontal="true">
